<?xml version="1.0" encoding="utf-8"?>
<!-- The encrypted API key is device-bound (Android Keystore) and must never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
